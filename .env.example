# Postgres connection string (Neon, Supabase, Render, or local)
DATABASE_URL=postgres://user:pass@host:5432/resist

# Admin area (/admin) is protected with HTTP Basic auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pick-a-long-random-password

# Public base URL, used for PayMongo success/cancel redirects
APP_URL=https://your-store.vercel.app

# PayMongo — leave PAYMONGO_SECRET_KEY empty to use the built-in mock checkout
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Without a key, the fake payment page runs in dev and on Vercel previews only.
# Set to true to allow it on production too (demos only: anyone can "pay").
ALLOW_MOCK_PAYMENTS=
# Optional: comma-separated, must be enabled on your PayMongo account
PAYMONGO_PAYMENT_METHODS=gcash,paymaya,card,qrph,grab_pay

# Optional: how long a checkout holds stock (minutes)
RESERVATION_MINUTES=30

# Order confirmation email via Resend (https://resend.com). Leave blank to skip emails.
RESEND_API_KEY=
# Must be on a domain you've verified in Resend
EMAIL_FROM="RESIST <orders@yourdomain.ph>"
# Optional: where customer replies go
EMAIL_REPLY_TO=
